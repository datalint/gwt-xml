<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.datalint.gwt.xml</groupId>
    <artifactId>xml-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <developers>
        <developer>
            <name>Hua Zhang</name>
            <email>hzhang1978@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <xml.version>1.0</xml.version>
        <xml.groupId>com.datalint.gwt.xml</xml.groupId>

        <revision>${xml.version}</revision>

        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <gwt.version>2.13.1</gwt.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <guava.version>33.6.0-jre</guava.version>
        <elemental2.version>1.3.2</elemental2.version>
        <domino-ui.version>2.1.0</domino-ui.version>
        <saxon-he.version>13.0</saxon-he.version>
        <playwright.version>1.61.0</playwright.version>

        <!-- Spring Boot dependency properties — update them whenever you upgrade the Spring Boot version. -->
        <mockito.version>5.23.0</mockito.version>

        <maven.compiler.plugin>3.15.0</maven.compiler.plugin>
        <maven.source.plugin>3.4.0</maven.source.plugin>
        <maven.resources.plugin>3.5.0</maven.resources.plugin>
        <maven.surefire.plugin>3.5.6</maven.surefire.plugin>
        <maven.failsafe.plugin>3.5.6</maven.failsafe.plugin>
        <maven.jar.plugin>3.5.0</maven.jar.plugin>
        <maven.war.plugin>3.5.1</maven.war.plugin>
        <maven.deploy.plugin>3.1.4</maven.deploy.plugin>
        <maven.install.plugin>3.1.4</maven.install.plugin>

        <gwt.maven.plugin>1.3.0</gwt.maven.plugin>
        <flatten.maven.plugin>1.7.3</flatten.maven.plugin>
    </properties>

    <modules>
        <module>client</module>
        <module>shared</module>
        <module>server</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.gwtproject</groupId>
                <artifactId>gwt</artifactId>
                <version>${gwt.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-core</artifactId>
                <version>${elemental2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-dom</artifactId>
                <version>${elemental2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-svg</artifactId>
                <version>${elemental2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-webstorage</artifactId>
                <version>${elemental2.version}</version>
            </dependency>

            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-ui</artifactId>
                <version>${domino-ui.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-ui</artifactId>
                <version>${domino-ui.version}</version>
                <classifier>sources</classifier>
            </dependency>

            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava-gwt</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <dependency>
                <groupId>net.sf.saxon</groupId>
                <artifactId>Saxon-HE</artifactId>
                <version>${saxon-he.version}</version>
            </dependency>

            <dependency>
                <groupId>${xml.groupId}</groupId>
                <artifactId>xml-shared</artifactId>
                <version>${xml.version}</version>
            </dependency>
            <dependency>
                <groupId>${xml.groupId}</groupId>
                <artifactId>xml-shared</artifactId>
                <version>${xml.version}</version>
                <classifier>sources</classifier>
            </dependency>
            <dependency>
                <groupId>${xml.groupId}</groupId>
                <artifactId>xml-client</artifactId>
                <version>${xml.version}</version>
            </dependency>
            <dependency>
                <groupId>${xml.groupId}</groupId>
                <artifactId>xml-server</artifactId>
                <version>${xml.version}</version>
            </dependency>

            <dependency>
                <groupId>${xml.groupId}</groupId>
                <artifactId>xml-server</artifactId>
                <version>${xml.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven.source.plugin}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin}</version>
                    <configuration>
                        <skipIfEmpty>true</skipIfEmpty>
                    </configuration>
                </plugin>

                <plugin>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven.war.plugin}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin}</version>
                </plugin>

                <plugin>
                    <groupId>net.ltgt.gwt.maven</groupId>
                    <artifactId>gwt-maven-plugin</artifactId>
                    <version>${gwt.maven.plugin}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <sourceLevel>${maven.compiler.release}</sourceLevel>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten.maven.plugin}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
